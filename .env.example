# RPC endpoints (referenced by foundry.toml [rpc_endpoints])
AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# Deployer private key (NEVER commit your real .env)
PRIVATE_KEY=

# Block explorer verification (Snowtrace)
SNOWTRACE_API_KEY=your_snowtrace_api_key

# EverestOrBust deploy vars
# Avalanche C-Chain mainnet addresses (verify against Snowtrace before real deploy)
USDC_ADDRESS=0xB97EF9Ef8734C71904D8002F8b6Bc66Dd9c48a6E
USDT_ADDRESS=0x9702230A8Ea53601f5cD2dc00fDBc13d4dF4A8c7

# Fuji testnet addresses — TBD, look up before testnet deploy
# USDC_ADDRESS=
# USDT_ADDRESS=

# Factory address (set after deploying CrowdFundFactory)
FACTORY_ADDRESS=
